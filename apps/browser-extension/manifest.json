{
  "manifest_version": 3,
  "name": "ChainXray Provider Capture",
  "version": "0.1.9",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://app.uniswap.org/*"
  ],
  "content_scripts": [{
    "matches": ["https://app.uniswap.org/*"],
    "js": ["early-provider.js"],
    "run_at": "document_start",
    "world": "MAIN"
  },{
    "matches": ["https://app.uniswap.org/*"],
    "js": ["auto-enable.js"],
    "run_at": "document_start"
  }],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
